# Provider: ollama, openai, peek, groq, ...
# Aliases: local=ollama, cloud=openai, hdfc=peek
LLM_PROVIDER=openai
# LLM_MODE is still accepted as an alias for LLM_PROVIDER

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Peek AI / HDFC LiteLLM (OpenAI chat/completions, not MCP JSON-RPC)
# PEEK_API_KEY=
# PEEK_BASE_URL=https://genai-proxy-uat.hdfcbankuat.com/UAT/litellm
# PEEK_MODEL=gemini-2.5-flash
# PEEK_TEMPERATURE=0.7
# PEEK_MAX_TOKENS=1000
# PEEK_VERIFY_SSL=false
# LLM_PROVIDER=peek
# EMBEDDING_PROVIDER=none

# Semantic search
EMBEDDING_SIMILARITY_THRESHOLD=0.25

# SQL query cache (reuse validated SQL for similar questions)
QUERY_CACHE_ENABLED=true
QUERY_CACHE_SIMILARITY_THRESHOLD=0.90

USE_SQL_QUERY_CHAIN=true
